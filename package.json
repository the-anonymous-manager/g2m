{
  "name": "g2m-life",
  "version": "1.0.0",
  "private": true,
  "description": "G2M · Gwei 2 Merchant — the crypto card directory",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && node scripts/generate-og-fonts.mjs && next build",
    "start": "next start",
    "validate": "node scripts/validate-cards.mjs",
    "i18n:missing": "node scripts/i18n-missing.mjs",
    "sheet:sync": "node scripts/sheet-sync.mjs",
    "sheet:export": "node scripts/sheet-export.mjs",
    "cf:build": "npm run validate && node scripts/generate-og-fonts.mjs && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "postcss": "^8.5.31"
  }
}
