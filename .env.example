# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://g2m.life
# Where "Submit a card" messages are sent
NEXT_PUBLIC_CONTACT_EMAIL=info@g2m.life
# Your X handle, e.g. @g2mlife (optional)
NEXT_PUBLIC_TWITTER_HANDLE=@0akash0x
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@g2mcrypto
NEXT_PUBLIC_TELEGRAM_HANDLE=@Akash773
# Plausible analytics domain, e.g. g2m.life (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible script URL, only needed if your Plausible account uses a custom/renamed script
# (its "Installation" screen shows this; defaults to the standard Plausible script otherwise)
NEXT_PUBLIC_PLAUSIBLE_SRC=
# CoinGecko demo API key for live staking-token prices (optional; set it as a Cloudflare Worker secret in production).
# Without it the public API is used, with DefiLlama as a backup.
COINGECKO_API_KEY=
# Password for the private /stats page (G2M's own analytics). In production a Cloudflare Worker secret; locally put it
# in .dev.vars (not committed) for `npm run cf:preview`.
STATS_PASSWORD=
